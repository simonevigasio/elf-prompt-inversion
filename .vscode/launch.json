{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pipeline: layer 3",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "experiments.pipeline",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "configs/pipeline/layer_3.yaml"],
      "env": {"PYTHONDONTWRITEBYTECODE": "1"},
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Corruption: debug ricerca (JIT)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "experiments.corruption",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "--config", "configs/corruption/debug_projected.yaml",
        "--dataset", "experiments/examples/smoke.jsonl",
        "--output", "${input:debugOutput}",
        "--modes", "projected"
      ],
      "env": {
        "JAX_DISABLE_JIT": "0",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Corruption: debug forward (senza JIT)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "experiments.corruption",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "--config", "configs/corruption/debug_projected.yaml",
        "--dataset", "experiments/examples/smoke.jsonl",
        "--output", "${input:debugOutput}",
        "--modes", "projected"
      ],
      "env": {
        "JAX_DISABLE_JIT": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "debugOutput",
      "type": "promptString",
      "description": "Cartella risultati relativa alla radice del progetto: scegli un nuovo nome per rieseguire i trial",
      "default": "outputs/corruption/debug-projected-01"
    }
  ]
}
